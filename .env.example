# GitHub API Configuration (for public/authenticated access)
VITE_GITHUB_OWNER=rhaberer
VITE_GITHUB_REPO=daily-art

# Optional: GitHub Personal Access Token (for higher API rate limits)
# Generate at: https://github.com/settings/tokens
# Needs: public_repo scope (or 'repo' for private repos)
VITE_GITHUB_TOKEN=

# LOCAL MODE: Set to true to use local server instead of GitHub API
# This reads from ../daily-art/ directory on your local machine
VITE_USE_LOCAL_SERVER=false
